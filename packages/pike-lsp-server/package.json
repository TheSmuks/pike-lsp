{
  "name": "@pike-lsp/pike-lsp-server",
  "version": "0.1.0-alpha.41",
  "description": "Pike Language Server Protocol implementation",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "pike-lsp-server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "build:roxen-data": "bun run scripts/build-roxen-data.ts",
    "prebuild": "bun run build:roxen-data",
    "clean": "rm -rf dist",
    "watch": "tsc --watch",
    "test": "bun test",
    "test:fault": "bun test src/scenarios/fault-*.test.ts",
    "test:invariants": "bun test src/testing/property-tests/query-engine-v2-rfc-invariants.test.ts src/testing/stress-scenarios/revision-monotonicity.stress.test.ts src/scenarios/fault-invariant.test.ts",
    "test:stress": "bun test src/testing/stress-scenarios",
    "test:snapshots:check": "bun test src/tests/navigation/hover-provider.snapshot.test.ts src/tests/helpers/snapshot-fixture.test.ts",
    "test:snapshots:update": "bun test --update-snapshots src/tests/navigation/hover-provider.snapshot.test.ts src/tests/helpers/snapshot-fixture.test.ts",
    "test:slow": "bun test src/tests/slow-integration/",
    "test:smoke": "bun test src/tests/",
    "test:source-trees": "PIKE_SOURCE_TREE_TEST=1 bun test src/tests/source-tree-e2e.test.ts",
    "test:property": "bun test src/testing/property-tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "benchmark": "bun benchmarks/runner.ts",
    "benchmark:hover": "bun benchmarks/hover-benchmark.ts"
  },
  "dependencies": {
    "@pike-lsp/core": "workspace:^",
    "@pike-lsp/pike-bridge": "workspace:^",
    "fast-check": "^4.6.0",
    "htmlparser2": "^10.1.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "glob": "^13.0.1",
    "mitata": "^1.0.34",
    "typescript": "^5.3.0"
  }
}
